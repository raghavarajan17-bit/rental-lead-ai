{
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/confirmation",
      "destination": "/confirmation.html"
    },
    {
      "source": "/thank-you",
      "destination": "/confirmation.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
